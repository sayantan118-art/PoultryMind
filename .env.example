# DATABASE
POSTGRES_DB=poultry_dev
POSTGRES_USER=poultry_user
POSTGRES_PASSWORD=poultry_dev_pass
DATABASE_URL=postgresql://poultry_user:poultry_dev_pass@localhost:5432/poultry_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# AWS
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=ap-south-1

# AWS COGNITO
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXX
COGNITO_CLIENT_ID=your_client_id
COGNITO_REGION=ap-south-1

# JWT
JWT_SECRET_KEY=your_secret_key_min_32_chars
JWT_ALGORITHM=HS256

# REDIS
REDIS_URL=redis://localhost:6379/0

# APP CONFIG
ENVIRONMENT=development
LOG_LEVEL=DEBUG
APP_PORT=8000
