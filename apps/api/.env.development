# Environment: Development
# Copy to apps/api/.env and customize

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=postgresql://poultry_user:poultry_dev_pass@localhost:5432/poultry_dev
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=False

# ==========================================
# REDIS (Caching)
# ==========================================
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SHORT=300
REDIS_TTL_LONG=3600

# ==========================================
# APP CONFIGURATION
# ==========================================
ENVIRONMENT=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=DEBUG
DEBUG=True

# ==========================================
# JWT & SECURITY
# ==========================================
# IMPORTANT: Generate a new secret key for dev/prod
# Python: from cryptography.fernet import Fernet; Fernet.generate_key()
JWT_SECRET_KEY=your_super_secret_dev_key_min_32_characters_very_secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# ==========================================
# AWS CONFIGURATION
# ==========================================
# NOTE: These are placeholders. Fill in your AWS credentials.
# RECOMMENDATION: Use AWS IAM roles in production, not hardcoded keys.
# SEE: https://docs.aws.amazon.com/general/latest/gr/aws-sec-cred-types.html

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY_HERE
AWS_ACCOUNT_ID=YOUR_12_DIGIT_ACCOUNT_ID

# ==========================================
# AWS COGNITO (Authentication)
# ==========================================
# NOTE: Set up Cognito user pool manually in AWS Console
# SEE: DEPLOYMENT.md Phase 1.3 for step-by-step instructions

COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX  # Replace with your pool ID
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx      # Replace with your client ID
COGNITO_REGION=ap-south-1
COGNITO_DOMAIN=yourdomain.auth.ap-south-1.amazoncognito.com

# ==========================================
# AWS SNS (Push Notifications)
# ==========================================
SNS_TOPIC_ARN_CRITICAL=arn:aws:sns:ap-south-1:ACCOUNT_ID:poultry-alerts-critical
SNS_TOPIC_ARN_WARNING=arn:aws:sns:ap-south-1:ACCOUNT_ID:poultry-alerts-warning

# ==========================================
# AWS SECRETS MANAGER (For production)
# ==========================================
USE_AWS_SECRETS_MANAGER=False
AWS_SECRETS_REGION=ap-south-1

# ==========================================
# CORS & ALLOWED ORIGINS
# ==========================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:3000,http://127.0.0.1:5173

# ==========================================
# PUSH NOTIFICATIONS (Expo)
# ==========================================
EXPO_ACCESS_TOKEN=YOUR_EXPO_ACCESS_TOKEN_HERE

# ==========================================
# EMAIL & COMMUNICATION
# ==========================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_app_password_not_regular_password
SENDER_EMAIL=noreply@farm.com
SENDER_NAME=Poultry Farm Command Center

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_RLS=True
ENABLE_ANALYTICS=True
ENABLE_PUSH_NOTIFICATIONS=True
ENABLE_WHATSAPP_ALERTS=False

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=5000

# ==========================================
# LOGGING
# ==========================================
LOG_FORMAT=json
LOG_TO_CLOUDWATCH=False
CLOUDWATCH_LOG_GROUP=/ecs/poultry-api

# ==========================================
# BACKUP & ARCHIVING
# ==========================================
ENABLE_DAILY_BACKUP=False
BACKUP_S3_BUCKET=poultry-backups-dev
BACKUP_RETENTION_DAYS=7
