# Environment: Production
# Copy to apps/api/.env and customize BEFORE deploying

# ==========================================
# DATABASE
# ==========================================
# IMPORTANT: Use AWS RDS endpoint, NOT localhost
# Get endpoint from: aws rds describe-db-instances
DATABASE_URL=postgresql://poultry_admin:PASSWORD_FROM_SECRETS_MANAGER@poultry-prod.XXXXX.ap-south-1.rds.amazonaws.com:5432/poultry_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_ECHO=False

# ==========================================
# REDIS (ElastiCache)
# ==========================================
# Get endpoint from: aws elasticache describe-replication-groups
REDIS_URL=redis://poultry-redis-prod.XXXXX.ng.0001.aps1.cache.amazonaws.com:6379/0
REDIS_TTL_SHORT=300
REDIS_TTL_LONG=3600

# ==========================================
# APP CONFIGURATION
# ==========================================
ENVIRONMENT=production
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
DEBUG=False

# ==========================================
# JWT & SECURITY
# ==========================================
# CRITICAL: Use AWS Secrets Manager to store this
# DO NOT commit to Git!
# SEE: aws secretsmanager get-secret-value --secret-id poultry/prod/jwt-secret
JWT_SECRET_KEY=FETCH_FROM_AWS_SECRETS_MANAGER_BEFORE_DEPLOY
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# ==========================================
# AWS CONFIGURATION
# ==========================================
# RECOMMENDATION: Use IAM roles attached to ECS task, NOT hardcoded keys
# SEE: https://docs.aws.amazon.com/AmazonECS/latest/developerguide/task-iam-roles.html

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=NOT_USED_WITH_IAM_ROLES
AWS_SECRET_ACCESS_KEY=NOT_USED_WITH_IAM_ROLES
AWS_ACCOUNT_ID=YOUR_12_DIGIT_ACCOUNT_ID

# ==========================================
# AWS COGNITO (Authentication)
# ==========================================
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=ap-south-1
COGNITO_DOMAIN=yourdomain.auth.ap-south-1.amazoncognito.com

# ==========================================
# AWS SNS (Push Notifications)
# ==========================================
SNS_TOPIC_ARN_CRITICAL=arn:aws:sns:ap-south-1:ACCOUNT_ID:poultry-alerts-critical
SNS_TOPIC_ARN_WARNING=arn:aws:sns:ap-south-1:ACCOUNT_ID:poultry-alerts-warning

# ==========================================
# AWS SECRETS MANAGER
# ==========================================
USE_AWS_SECRETS_MANAGER=True
AWS_SECRETS_REGION=ap-south-1

# ==========================================
# CORS & ALLOWED ORIGINS
# ==========================================
ALLOWED_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# ==========================================
# PUSH NOTIFICATIONS (Expo)
# ==========================================
# Store in Secrets Manager, not here
EXPO_ACCESS_TOKEN=FETCH_FROM_AWS_SECRETS_MANAGER

# ==========================================
# EMAIL & COMMUNICATION
# ==========================================
# Use SES for production instead of Gmail
SMTP_SERVER=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your_ses_username
SMTP_PASSWORD=your_ses_password
SENDER_EMAIL=noreply@farm.com
SENDER_NAME=Poultry Farm Command Center

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_RLS=True
ENABLE_ANALYTICS=True
ENABLE_PUSH_NOTIFICATIONS=True
ENABLE_WHATSAPP_ALERTS=True

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_REQUESTS_PER_HOUR=50000

# ==========================================
# LOGGING
# ==========================================
LOG_FORMAT=json
LOG_TO_CLOUDWATCH=True
CLOUDWATCH_LOG_GROUP=/ecs/poultry-api-prod

# ==========================================
# BACKUP & ARCHIVING
# ==========================================
ENABLE_DAILY_BACKUP=True
BACKUP_S3_BUCKET=poultry-backups-prod
BACKUP_RETENTION_DAYS=30
